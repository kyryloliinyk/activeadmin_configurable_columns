<% if resources.empty? %>
  <div class="panel">
    <div class="panel-body"><%= t('active_admin.table_columns.empty') %></div>
  </div>
<% else %>
  <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    <% resources.each do |resource| %>
      <div class="panel">
        <h3 class="panel-title"><%= resource.plural_resource_label %></h3>
        <div class="panel-body">
          <%= render 'activeadmin_configurable_columns/form', resource: resource %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
