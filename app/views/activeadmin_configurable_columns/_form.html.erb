<%# Sortable checkbox picker for one index table. Rendered both in the index
    sidebar and on the "Table columns" page, so it always posts back to the
    same action. Each row's hidden `columns[]` input carries the order. %>
<% registry = resource.column_registry %>
<% selection = ActiveadminConfigurableColumns.selection_for(registry, current_active_admin_user) %>
<% update_path = send(ActiveadminConfigurableColumns.route_name(active_admin_namespace, :update)) %>

<%= form_with url: update_path, method: :patch, class: 'filters-form' do %>
  <%= hidden_field_tag :resource_key, registry.resource_key, id: nil %>

  <ul data-aacc-list class="flex flex-col gap-1 mb-4 [&>.aacc-ghost]:opacity-40 [&>.aacc-chosen]:bg-gray-100 dark:[&>.aacc-chosen]:bg-gray-800">
    <% selection.columns.each do |column| %>
      <% checkbox_id = "#{registry.resource_key}_column_#{column.key}" %>
      <% label = column.human_label(resource.resource_class) %>
      <li data-aacc-row class="flex items-center gap-2 rounded">
        <%= hidden_field_tag 'columns[]', column.key, id: nil %>
        <button type="button" data-aacc-handle
                class="inline-flex cursor-grab touch-none select-none rounded p-0.5 text-gray-400 hover:text-gray-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 dark:hover:text-gray-200"
                aria-label="<%= t('active_admin.table_columns.move', column: label) %>"
                title="<%= t('active_admin.table_columns.reorder_hint') %>">
          <svg aria-hidden="true" class="size-4" viewBox="0 0 16 16" fill="currentColor">
            <circle cx="5.5" cy="3.5" r="1.5"/><circle cx="10.5" cy="3.5" r="1.5"/>
            <circle cx="5.5" cy="8" r="1.5"/><circle cx="10.5" cy="8" r="1.5"/>
            <circle cx="5.5" cy="12.5" r="1.5"/><circle cx="10.5" cy="12.5" r="1.5"/>
          </svg>
        </button>
        <%= check_box_tag 'visible_columns[]', column.key, selection.visible?(column), id: checkbox_id %>
        <%= label_tag checkbox_id, label, class: 'text-sm' %>
      </li>
    <% end %>
  </ul>

  <div class="filters-form-buttons">
    <%= submit_tag t('active_admin.table_columns.save'), class: 'filters-form-submit' %>
    <%= button_tag t('active_admin.table_columns.reset'), name: 'reset', value: '1',
                   class: 'text-sm text-gray-600 underline hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100' %>
  </div>
<% end %>

<%= render 'activeadmin_configurable_columns/script' %>
