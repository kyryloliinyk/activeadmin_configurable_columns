<%# Checkbox picker for one index table. Rendered both in the index sidebar and
    on the "Table columns" page, so it always posts back to the same action. %>
<% registry = resource.column_registry %>
<% selected = ActiveadminConfigurableColumns.visible_columns(registry, current_active_admin_user).map(&:key) %>
<% update_path = send(ActiveadminConfigurableColumns.route_name(active_admin_namespace, :update)) %>

<%= form_with url: update_path, method: :patch, class: 'filters-form' do %>
  <%= hidden_field_tag :resource_key, registry.resource_key, id: nil %>
  <%# Keeps the parameter present when every box is unchecked, which restores the defaults. %>
  <%= hidden_field_tag 'visible_columns[]', '', id: nil %>

  <div class="flex flex-col gap-2 mb-4">
    <% registry.columns.each do |column| %>
      <% checkbox_id = "#{registry.resource_key}_column_#{column.key}" %>
      <div class="flex items-center gap-2">
        <%= check_box_tag 'visible_columns[]', column.key, selected.include?(column.key), id: checkbox_id %>
        <%= label_tag checkbox_id, column.human_label(resource.resource_class), class: 'text-sm' %>
      </div>
    <% end %>
  </div>

  <div class="filters-form-buttons">
    <%= submit_tag t('active_admin.table_columns.save'), class: 'filters-form-submit' %>
  </div>
<% end %>
